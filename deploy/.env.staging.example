# Staging-only values. Copy to .env.staging; never reuse production secrets.
APP_MODE=PROD_MODE
SCIPAL_ENV=staging
SCIPAL_SECRET_KEY=CHANGE_ME_STAGING_SECRET
SCIPAL_INTERNAL_TOKEN=CHANGE_ME_STAGING_INTERNAL_TOKEN
PARADEDB_PASSWORD=CHANGE_ME_STAGING_PARADEDB

# All staging DSNs must point at scipal_staging_* databases.
SCIPAL_CORE_DSN=postgresql://scipal:CHANGE_ME@127.0.0.1:5433/scipal_staging_core
SCIPAL_PG_DSN=postgresql://scipal:CHANGE_ME@127.0.0.1:5433/scipal_staging_core
SCIPAL_AUTH_DSN=postgresql://scipal:CHANGE_ME@127.0.0.1:5433/scipal_staging_core
SCIPAL_CORE_READ_DSN=postgresql://scipal_core_reader:CHANGE_ME@host.docker.internal:5433/scipal_staging_core
SCIPAL_CODE_READ_DSN=postgresql://scipal_code_reader:CHANGE_ME@host.docker.internal:5433/scipal_staging_code
SCIPAL_CODE_BM25_DSN=postgresql://postgres:CHANGE_ME@host.docker.internal:5435/scipal_staging_g0
SCIPAL_PG_CORPUS_DSN=postgresql://scipal:CHANGE_ME@127.0.0.1:5433/scipal_staging_rebuild

# Optional model keys for staging; leave empty to keep LLM disabled.
SCIPAL_LLM_API_KEY=
SCIPAL_LLM_MODEL=
